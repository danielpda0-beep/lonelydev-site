---
// src/components/FisicaQuanticaFX.astro
// M20: Fundo + detalhe interativo do tema Física Quântica (Decisão 10.25)
// Partículas de fundo que passam perto do cursor "colapsam" num ponto fixo por ~0,5s
// (referência ao colapso da função de onda) e voltam a se espalhar.
---

<div id="fq-fx-root" aria-hidden="true">
  <canvas id="fq-bg-canvas" class="fq-bg-canvas"></canvas>
</div>

<style>
  .fq-bg-canvas {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  :global([data-theme="fisica-quantica"]) .fq-bg-canvas {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .fq-bg-canvas { display: none !important; }
  }
</style>

<script>
  (function () {
    const w = window as any;
    if (w.__fqFxBound) return;
    w.__fqFxBound = true;

    function isFqTheme(): boolean {
      return document.documentElement.getAttribute('data-theme') === 'fisica-quantica';
    }
    function isReducedMotion(): boolean {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;

    function acquireCanvas() {
      const el = document.getElementById('fq-bg-canvas') as HTMLCanvasElement | null;
      if (el && el !== canvas) {
        canvas = el;
        ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
    }
    window.addEventListener('resize', () => {
      if (canvas) { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    });

    interface Particle {
      bx: number; by: number; // posição base (deriva lenta em torno dela)
      x: number; y: number;   // posição atual desenhada
      angle: number; speed: number; r: number;
      collapsed: boolean; collapseUntil: number; cx: number; cy: number;
    }
    const particles: Particle[] = [];
    let inited = false;

    // Hook de debug pra QA automatizado (Playwright) — sem custo em produção.
    w.__fqFxDebug = () => ({
      total: particles.length,
      collapsed: particles.filter((p) => p.collapsed).length,
    });

    function initParticles(width: number, height: number) {
      particles.length = 0;
      for (let i = 0; i < 90; i++) {
        const bx = Math.random() * width;
        const by = Math.random() * height;
        particles.push({
          bx, by, x: bx, y: by,
          angle: Math.random() * Math.PI * 2,
          speed: 0.15 + Math.random() * 0.25,
          r: Math.random() * 1.6 + 0.6,
          collapsed: false, collapseUntil: 0, cx: 0, cy: 0,
        });
      }
    }

    let mouseX = -9999;
    let mouseY = -9999;
    window.addEventListener('mousemove', (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    function drawWaveFunctions(t: number) {
      if (!ctx || !canvas) return;
      ctx.strokeStyle = 'rgba(124, 107, 255, 0.14)';
      ctx.lineWidth = 1;
      const rows = 4;
      for (let row = 0; row < rows; row++) {
        const baseY = (canvas.height / (rows + 1)) * (row + 1);
        const amp = 14 + row * 4;
        const freq = 0.006 + row * 0.0015;
        ctx.beginPath();
        for (let x = 0; x <= canvas.width; x += 8) {
          const y = baseY + Math.sin(x * freq + t * 0.0006 + row) * amp;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
    }

    function drawParticles(now: number, reduce: boolean) {
      if (!ctx || !canvas) return;
      const collapseRadius = 70;
      for (const p of particles) {
        if (!reduce) {
          if (p.collapsed) {
            if (now > p.collapseUntil) {
              p.collapsed = false;
            }
          } else {
            const dx = p.x - mouseX;
            const dy = p.y - mouseY;
            if (mouseX > -1000 && Math.hypot(dx, dy) < collapseRadius) {
              p.collapsed = true;
              p.collapseUntil = now + 500;
              p.cx = p.x;
              p.cy = p.y;
            }
          }
        }

        if (p.collapsed) {
          p.x = p.cx;
          p.y = p.cy;
        } else if (!reduce) {
          p.angle += 0.004;
          p.x = p.bx + Math.cos(p.angle) * 18;
          p.y = p.by + Math.sin(p.angle * 1.3) * 18;
        } else {
          p.x = p.bx;
          p.y = p.by;
        }

        if (p.collapsed) {
          const remaining = (p.collapseUntil - now) / 500;
          ctx.globalAlpha = 0.5 + remaining * 0.5;
          ctx.fillStyle = '#eef0ff';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r * 1.8, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = 'rgba(238, 240, 255, 0.5)';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r * 1.8 + 4 * (1 - remaining), 0, Math.PI * 2);
          ctx.stroke();
        } else {
          ctx.globalAlpha = 0.55;
          ctx.fillStyle = '#7c6bff';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }

    function frame(t: number) {
      requestAnimationFrame(frame);
      if (document.hidden || !isFqTheme()) return;
      acquireCanvas();
      if (!canvas || !ctx) return;
      if (!inited) { initParticles(canvas.width, canvas.height); inited = true; }

      const reduce = isReducedMotion();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (!reduce) drawWaveFunctions(t);
      drawParticles(t, reduce);
    }
    requestAnimationFrame(frame);
  })();
</script>
