---
// src/components/BlueprintFX.astro
// M20: Fundo + detalhe interativo do tema Blueprint (Decisão 10.25, os 3 escolhidos)
// (a) cursor vira mira técnica com coordenadas X/Y em tempo real
// (b) linha de cota tracejada entre o último clique e a posição atual do cursor
// (c) linhas do grid mais próximas do cursor se destacam sutilmente
// Cursor customizado: a própria mira técnica (função dupla, 10.24).
---

<div id="bp-fx-root" aria-hidden="true">
  <div class="bp-grid-bg"></div>
  <canvas id="bp-fx-canvas" class="bp-fx-canvas"></canvas>
  <div id="bp-cursor" class="bp-cursor">
    <svg width="32" height="32" viewBox="0 0 32 32" class="bp-cursor-svg">
      <circle cx="16" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="16" cy="16" r="1.6" fill="currentColor"/>
      <line x1="16" y1="0" x2="16" y2="8" stroke="currentColor" stroke-width="1.5"/>
      <line x1="16" y1="24" x2="16" y2="32" stroke="currentColor" stroke-width="1.5"/>
      <line x1="0" y1="16" x2="8" y2="16" stroke="currentColor" stroke-width="1.5"/>
      <line x1="24" y1="16" x2="32" y2="16" stroke="currentColor" stroke-width="1.5"/>
    </svg>
    <span id="bp-coords" class="bp-coords">X:0 Y:0</span>
  </div>
</div>

<style>
  .bp-grid-bg,
  .bp-fx-canvas {
    display: none;
  }

  :global([data-theme="blueprint"]) .bp-grid-bg {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(to right, rgba(79, 195, 247, 0.16) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(to bottom, rgba(79, 195, 247, 0.16) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(to right, rgba(79, 195, 247, 0.08) 0 1px, transparent 1px 8px),
      repeating-linear-gradient(to bottom, rgba(79, 195, 247, 0.08) 0 1px, transparent 1px 8px);
  }

  :global([data-theme="blueprint"]) .bp-fx-canvas {
    display: block;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1;
    pointer-events: none;
  }

  .bp-cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2000;
    pointer-events: none;
    color: #4fc3f7;
    transform: translate(-9999px, -9999px);
    will-change: transform;
  }

  html.ld-cursor-fx-active[data-theme="blueprint"] .bp-cursor {
    display: flex;
    align-items: center;
  }

  .bp-cursor-svg {
    filter: drop-shadow(0 0 3px rgba(79, 195, 247, 0.7));
  }

  .bp-coords {
    margin-left: 0.4rem;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 0.7rem;
    background: rgba(11, 42, 74, 0.85);
    border: 1px solid rgba(79, 195, 247, 0.5);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-fx-canvas { display: none !important; }
    .bp-cursor { display: none !important; }
  }
</style>

<script>
  (function () {
    const w = window as any;
    if (w.__bpFxBound) return;
    w.__bpFxBound = true;

    const GRID = 40;

    function isBpTheme(): boolean {
      return document.documentElement.getAttribute('data-theme') === 'blueprint';
    }
    function isReducedMotion(): boolean {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }
    function isTouchDevice(): boolean {
      return window.matchMedia('(pointer: coarse)').matches;
    }

    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;
    let cursorEl: HTMLElement | null = null;
    let coordsEl: HTMLElement | null = null;

    function acquireEls() {
      const c = document.getElementById('bp-fx-canvas') as HTMLCanvasElement | null;
      if (c && c !== canvas) {
        canvas = c;
        ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      cursorEl = document.getElementById('bp-cursor');
      coordsEl = document.getElementById('bp-coords');
    }
    window.addEventListener('resize', () => {
      if (canvas) { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    });

    let mouseX = -9999;
    let mouseY = -9999;
    let hasMouse = false;
    let lastClick: { x: number; y: number } | null = null;

    // Hook de debug pra QA automatizado (Playwright) — sem custo em produção.
    w.__bpFxDebug = () => ({
      active: document.documentElement.classList.contains('ld-cursor-fx-active'),
      hasMouse,
      hasLastClick: !!lastClick,
      coordsText: document.getElementById('bp-coords')?.textContent || '',
    });

    function updateActiveState() {
      // Só esconde o cursor nativo depois do 1º mousemove real — evita um cursor
      // invisível no instante do carregamento, antes da mira dinâmica ter posição.
      const active = isBpTheme() && hasMouse && !isReducedMotion() && !isTouchDevice();
      document.documentElement.classList.toggle('ld-cursor-fx-active', active);
      return active;
    }

    window.addEventListener('mousemove', (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      hasMouse = true;
      if (!updateActiveState()) return;
      if (cursorEl) {
        cursorEl.style.transform = `translate(${mouseX - 16}px, ${mouseY - 16}px)`;
      }
      if (coordsEl) {
        coordsEl.textContent = `X:${Math.round(mouseX)} Y:${Math.round(mouseY)}`;
      }
    });

    window.addEventListener('click', (e: MouseEvent) => {
      if (!isBpTheme()) return;
      lastClick = { x: e.clientX, y: e.clientY };
    });

    function drawGridHighlight() {
      if (!ctx || !canvas || !hasMouse) return;
      const nearestX = Math.round(mouseX / GRID) * GRID;
      const nearestY = Math.round(mouseY / GRID) * GRID;

      ctx.strokeStyle = 'rgba(79, 195, 247, 0.55)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(nearestX, 0);
      ctx.lineTo(nearestX, canvas.height);
      ctx.moveTo(0, nearestY);
      ctx.lineTo(canvas.width, nearestY);
      ctx.stroke();
    }

    function drawDimensionLine() {
      if (!ctx || !lastClick || !hasMouse) return;
      ctx.save();
      ctx.strokeStyle = 'rgba(234, 242, 251, 0.65)';
      ctx.lineWidth = 1;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(lastClick.x, lastClick.y);
      ctx.lineTo(mouseX, mouseY);
      ctx.stroke();
      ctx.restore();

      // marcadores de extremidade (tick de cota)
      ctx.fillStyle = '#4fc3f7';
      ctx.beginPath();
      ctx.arc(lastClick.x, lastClick.y, 2.5, 0, Math.PI * 2);
      ctx.fill();

      const dist = Math.round(Math.hypot(mouseX - lastClick.x, mouseY - lastClick.y));
      const midX = (lastClick.x + mouseX) / 2;
      const midY = (lastClick.y + mouseY) / 2;
      ctx.font = '11px "JetBrains Mono", monospace';
      ctx.fillStyle = 'rgba(234, 242, 251, 0.85)';
      ctx.fillText(`${dist}px`, midX + 6, midY - 6);
    }

    function frame() {
      requestAnimationFrame(frame);
      if (document.hidden || !isBpTheme()) return;
      acquireEls();
      if (!canvas || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const active = updateActiveState();
      if (!active) return;

      drawGridHighlight();
      drawDimensionLine();
    }
    requestAnimationFrame(frame);
  })();
</script>
