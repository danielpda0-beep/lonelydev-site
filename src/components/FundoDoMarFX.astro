---
// src/components/FundoDoMarFX.astro
// M19: Fundo do tema Fundo do Mar — cáusticas, partículas subindo e cardume interativo
// Decisão 10.23: peixes vivem NO MESMO canvas das cáusticas/partículas, não em camada nova.
---

<canvas id="mar-bg-canvas" class="mar-bg-canvas" aria-hidden="true"></canvas>

<style>
  .mar-bg-canvas {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  :global([data-theme="fundo-do-mar"]) .mar-bg-canvas {
    display: block;
  }
</style>

<script>
  (function () {
    const w = window as any;
    if (w.__marFxBound) return;
    w.__marFxBound = true;
    // Hook de depuração usado pelos testes automatizados (scripts/test-m19-temas.mjs)
    w.__marFxDebug = () => ({ chasingCount, states: fish.map((f) => f.state) });

    function isMarTheme(): boolean {
      return document.documentElement.getAttribute('data-theme') === 'fundo-do-mar';
    }
    function isReducedMotion(): boolean {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }
    function isTouchDevice(): boolean {
      return window.matchMedia('(pointer: coarse)').matches;
    }

    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;

    function acquireCanvas() {
      const el = document.getElementById('mar-bg-canvas') as HTMLCanvasElement | null;
      if (el && el !== canvas) {
        canvas = el;
        ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
    }
    window.addEventListener('resize', () => {
      if (canvas) { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    });

    // ── Partículas subindo ──
    interface Particle { x: number; y: number; r: number; speed: number; drift: number; phase: number; }
    const particles: Particle[] = [];
    function initParticles(width: number, height: number) {
      particles.length = 0;
      for (let i = 0; i < 26; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          r: 1 + Math.random() * 2,
          speed: 0.15 + Math.random() * 0.3,
          drift: Math.random() * Math.PI * 2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }
    let particlesInited = false;

    // ── Cardume interativo (Decisão 10.23) ──
    type FishState = 'drift' | 'chase' | 'nibble';
    interface Fish {
      x: number; y: number; vx: number; vy: number;
      state: FishState; nibbleUntil: number; size: number; hue: number;
      wiggle: number;
    }
    const fish: Fish[] = [];
    let fishInited = false;
    let chasingCount = 0;
    let lastMouseX = -9999;
    let lastMouseY = -9999;
    let mouseX = -9999;
    let mouseY = -9999;
    let mouseStillSince = 0;
    let lastAttractAt = 0;

    function initFish(width: number, height: number) {
      fish.length = 0;
      const count = 6 + Math.floor(Math.random() * 5); // 6-10
      for (let i = 0; i < count; i++) {
        fish.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.6,
          vy: (Math.random() - 0.5) * 0.3,
          state: 'drift',
          nibbleUntil: 0,
          size: 7 + Math.random() * 5,
          hue: 165 + Math.random() * 30,
          wiggle: Math.random() * Math.PI * 2,
        });
      }
    }

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (Math.hypot(e.clientX - lastMouseX, e.clientY - lastMouseY) > 3) {
        mouseStillSince = performance.now();
      }
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    function updateFish(now: number, dt: number) {
      const canChase = isMarTheme() && !isTouchDevice() && !isReducedMotion() && mouseX > -1000;
      const attractionRadius = 180;

      if (canChase) {
        const stillFor = now - mouseStillSince;
        // Atrai o peixe mais próximo ocioso; cursor parado por muito tempo pode atrair mais, um de cada vez.
        const cap = stillFor > 3000 ? Math.min(3, 1 + Math.floor((stillFor - 3000) / 4000)) : 1;
        if (chasingCount < cap && now - lastAttractAt > 600) {
          let nearest: Fish | null = null;
          let nearestDist = attractionRadius;
          for (const f of fish) {
            if (f.state !== 'drift') continue;
            const d = Math.hypot(f.x - mouseX, f.y - mouseY);
            if (d < nearestDist) {
              nearestDist = d;
              nearest = f;
            }
          }
          if (nearest) {
            nearest.state = 'chase';
            chasingCount++;
            lastAttractAt = now;
          }
        }
      }

      for (const f of fish) {
        f.wiggle += dt * 4;
        if (f.state === 'chase') {
          const dx = mouseX - f.x;
          const dy = mouseY - f.y;
          const dist = Math.hypot(dx, dy) || 1;
          const nx = dx / dist;
          const ny = dy / dist;
          // Oscilação lateral de nado real (perpendicular à direção)
          const perpX = -ny;
          const perpY = nx;
          const wob = Math.sin(f.wiggle) * 0.9;
          f.vx = nx * 1.4 + perpX * wob;
          f.vy = ny * 1.4 + perpY * wob;
          if (dist < 30) {
            f.state = 'nibble';
            f.nibbleUntil = now + 1000 + Math.random() * 1000;
          }
          if (!canChase) {
            f.state = 'drift';
            chasingCount = Math.max(0, chasingCount - 1);
          }
        } else if (f.state === 'nibble') {
          const angle = f.wiggle * 1.5;
          f.vx = Math.cos(angle) * 0.8;
          f.vy = Math.sin(angle) * 0.8;
          if (now > f.nibbleUntil) {
            f.state = 'drift';
            f.vx = (Math.random() - 0.5) * 0.6;
            f.vy = (Math.random() - 0.5) * 0.3;
            chasingCount = Math.max(0, chasingCount - 1);
          }
        } else {
          // deriva lenta e aleatória; reduced-motion => deriva mínima
          const speedMul = isReducedMotion() ? 0.25 : 1;
          f.vx += (Math.random() - 0.5) * 0.02;
          f.vy += (Math.random() - 0.5) * 0.015;
          const maxSpeed = 0.5 * speedMul;
          const sp = Math.hypot(f.vx, f.vy);
          if (sp > maxSpeed) {
            f.vx = (f.vx / sp) * maxSpeed;
            f.vy = (f.vy / sp) * maxSpeed;
          }
        }

        f.x += f.vx;
        f.y += f.vy;

        if (canvas) {
          const m = 40;
          if (f.x < -m) f.x = canvas.width + m;
          if (f.x > canvas.width + m) f.x = -m;
          if (f.y < -m) f.y = canvas.height + m;
          if (f.y > canvas.height + m) f.y = -m;
        }
      }
    }

    function drawFish() {
      if (!ctx) return;
      for (const f of fish) {
        const angle = Math.atan2(f.vy, f.vx || 0.001);
        ctx.save();
        ctx.translate(f.x, f.y);
        ctx.rotate(angle);
        const tailWiggle = Math.sin(f.wiggle) * 0.4;
        ctx.fillStyle = `hsla(${f.hue}, 70%, 65%, 0.85)`;
        ctx.beginPath();
        ctx.ellipse(0, 0, f.size, f.size * 0.5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-f.size, 0);
        ctx.lineTo(-f.size - f.size * 0.8, -f.size * 0.5 + tailWiggle * f.size);
        ctx.lineTo(-f.size - f.size * 0.8, f.size * 0.5 + tailWiggle * f.size);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }
    }

    function drawCaustics(t: number, width: number, height: number) {
      if (!ctx) return;
      ctx.save();
      ctx.globalAlpha = 0.06;
      ctx.strokeStyle = '#2dd4bf';
      for (let i = 0; i < 5; i++) {
        ctx.beginPath();
        const yBase = (height / 5) * i + (height / 10);
        for (let x = 0; x <= width; x += 20) {
          const y = yBase + Math.sin(x * 0.01 + t * 0.6 + i) * 18;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.lineWidth = 6;
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawParticles(dt: number, height: number) {
      if (!ctx) return;
      const reduce = isReducedMotion();
      ctx.save();
      for (const p of particles) {
        if (!reduce) {
          p.y -= p.speed;
          p.x += Math.sin(p.phase + performance.now() * 0.0005) * 0.15;
          if (p.y < -10) p.y = height + 10;
        }
        ctx.globalAlpha = 0.35;
        ctx.fillStyle = '#d9f5f5';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    let lastFrameTime = performance.now();

    function frame() {
      requestAnimationFrame(frame);
      if (document.hidden || !isMarTheme()) return;
      acquireCanvas();
      if (!canvas || !ctx) return;

      if (!particlesInited) { initParticles(canvas.width, canvas.height); particlesInited = true; }
      if (!fishInited) { initFish(canvas.width, canvas.height); fishInited = true; }

      const now = performance.now();
      const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
      lastFrameTime = now;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawCaustics(now / 1000, canvas.width, canvas.height);
      drawParticles(dt, canvas.height);
      updateFish(now, dt);
      drawFish();
    }
    requestAnimationFrame(frame);
  })();
</script>
