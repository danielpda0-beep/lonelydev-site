---
// src/components/SolarpunkFX.astro
// M21: Fundo + detalhes interativos do tema Solarpunk (Decisão 10.25)
// (a) borboletas/abelhas reagem ao cursor com o MESMO padrão comportamental dos peixes
//     do fundo-do-mar (deriva → curiosidade → belisca/pousa → volta a vagar) — Decisão 10.23
// (b) um brotinho/vinha nasce e murcha AO CLICAR (não ao mover)
// (c) pétalas/folhas caem DURANTE A TRANSIÇÃO DE PÁGINA (não continuamente)
---

<canvas id="solar-bg-canvas" class="solar-bg-canvas" aria-hidden="true"></canvas>
<div id="solar-petal-layer" class="solar-petal-layer" aria-hidden="true"></div>

<style>
  .solar-bg-canvas {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  :global([data-theme="solarpunk"]) .solar-bg-canvas {
    display: block;
  }

  .solar-petal-layer {
    display: none;
  }

  :global([data-theme="solarpunk"]) .solar-petal-layer {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    overflow: hidden;
  }

  :global(.solar-petal) {
    position: absolute;
    top: -5vh;
    width: 10px;
    height: 10px;
    border-radius: 0 70% 0 70%;
    background: #4ade80;
    opacity: 0.85;
    animation: solarPetalFall linear forwards;
  }

  @keyframes solarPetalFall {
    from { transform: translate(0, 0) rotate(0deg); opacity: 0.85; }
    to { transform: translate(var(--drift, 40px), 110vh) rotate(320deg); opacity: 0; }
  }

  :global(.solar-sprout) {
    position: fixed;
    z-index: 5;
    pointer-events: none;
    width: 26px;
    height: 34px;
    transform-origin: bottom center;
    transform: translate(-50%, -100%) scaleY(0);
    animation: solarSproutGrow 2.1s ease-out forwards;
  }

  @keyframes solarSproutGrow {
    0% { transform: translate(-50%, -100%) scaleY(0); opacity: 0; }
    28% { transform: translate(-50%, -100%) scaleY(1); opacity: 1; }
    70% { transform: translate(-50%, -100%) scaleY(1); opacity: 1; }
    100% { transform: translate(-50%, -100%) scaleY(0.15); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .solar-bg-canvas { display: none !important; }
  }
</style>

<script>
  (function () {
    const w = window as any;
    if (w.__solarFxBound) return;
    w.__solarFxBound = true;
    w.__solarFxDebug = () => ({ chasingCount, states: flutters.map((f) => f.state) });

    function isSolarTheme(): boolean {
      return document.documentElement.getAttribute('data-theme') === 'solarpunk';
    }
    function isReducedMotion(): boolean {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }
    function isTouchDevice(): boolean {
      return window.matchMedia('(pointer: coarse)').matches;
    }

    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;

    function acquireCanvas() {
      const el = document.getElementById('solar-bg-canvas') as HTMLCanvasElement | null;
      if (el && el !== canvas) {
        canvas = el;
        ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
    }
    window.addEventListener('resize', () => {
      if (canvas) { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    });

    // ── Borboletas/abelhas — mesmo padrão de estados dos peixes (Decisão 10.23) ──
    type FlutterState = 'drift' | 'chase' | 'nibble';
    interface Flutter {
      x: number; y: number; vx: number; vy: number;
      state: FlutterState; nibbleUntil: number; size: number; hue: number; wing: number;
    }
    const flutters: Flutter[] = [];
    let fluttersInited = false;
    let chasingCount = 0;
    let mouseX = -9999;
    let mouseY = -9999;
    let lastMouseX = -9999;
    let lastMouseY = -9999;
    let mouseStillSince = 0;
    let lastAttractAt = 0;

    function initFlutters(width: number, height: number) {
      flutters.length = 0;
      const count = 6 + Math.floor(Math.random() * 5); // 6-10
      for (let i = 0; i < count; i++) {
        flutters.push({
          x: Math.random() * width,
          y: Math.random() * height * 0.7,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.3,
          state: 'drift',
          nibbleUntil: 0,
          size: 6 + Math.random() * 4,
          hue: Math.random() > 0.5 ? 100 : 45, // verde ou âmbar (abelha)
          wing: Math.random() * Math.PI * 2,
        });
      }
    }

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (Math.hypot(e.clientX - lastMouseX, e.clientY - lastMouseY) > 3) {
        mouseStillSince = performance.now();
      }
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    function updateFlutters(now: number, dt: number) {
      const canChase = isSolarTheme() && !isTouchDevice() && !isReducedMotion() && mouseX > -1000;
      const attractionRadius = 170;

      if (canChase) {
        const stillFor = now - mouseStillSince;
        const cap = stillFor > 3000 ? Math.min(3, 1 + Math.floor((stillFor - 3000) / 4000)) : 1;
        if (chasingCount < cap && now - lastAttractAt > 600) {
          let nearest: Flutter | null = null;
          let nearestDist = attractionRadius;
          for (const f of flutters) {
            if (f.state !== 'drift') continue;
            const d = Math.hypot(f.x - mouseX, f.y - mouseY);
            if (d < nearestDist) { nearestDist = d; nearest = f; }
          }
          if (nearest) {
            nearest.state = 'chase';
            chasingCount++;
            lastAttractAt = now;
          }
        }
      }

      for (const f of flutters) {
        f.wing += dt * 10;
        if (f.state === 'chase') {
          const dx = mouseX - f.x;
          const dy = mouseY - f.y;
          const dist = Math.hypot(dx, dy) || 1;
          const nx = dx / dist;
          const ny = dy / dist;
          const perpX = -ny, perpY = nx;
          const wob = Math.sin(f.wing * 0.5) * 1.1;
          f.vx = nx * 1.1 + perpX * wob;
          f.vy = ny * 1.1 + perpY * wob;
          if (dist < 26) {
            f.state = 'nibble';
            f.nibbleUntil = now + 900 + Math.random() * 900;
          }
          if (!canChase) { f.state = 'drift'; chasingCount = Math.max(0, chasingCount - 1); }
        } else if (f.state === 'nibble') {
          // "pousa": quase parado, só o bater de asas continua
          f.vx *= 0.85;
          f.vy *= 0.85;
          if (now > f.nibbleUntil) {
            f.state = 'drift';
            f.vx = (Math.random() - 0.5) * 0.5;
            f.vy = (Math.random() - 0.5) * 0.3;
            chasingCount = Math.max(0, chasingCount - 1);
          }
        } else {
          const speedMul = isReducedMotion() ? 0.25 : 1;
          f.vx += (Math.random() - 0.5) * 0.02;
          f.vy += (Math.random() - 0.5) * 0.015;
          const maxSpeed = 0.45 * speedMul;
          const sp = Math.hypot(f.vx, f.vy);
          if (sp > maxSpeed) { f.vx = (f.vx / sp) * maxSpeed; f.vy = (f.vy / sp) * maxSpeed; }
        }

        f.x += f.vx;
        f.y += f.vy;

        if (canvas) {
          const m = 30;
          if (f.x < -m) f.x = canvas.width + m;
          if (f.x > canvas.width + m) f.x = -m;
          if (f.y < -m) f.y = canvas.height * 0.75 + m;
          if (f.y > canvas.height * 0.75 + m) f.y = -m;
        }
      }
    }

    function drawFlutters() {
      if (!ctx) return;
      for (const f of flutters) {
        const flap = Math.sin(f.wing);
        ctx.save();
        ctx.translate(f.x, f.y);
        ctx.fillStyle = `hsla(${f.hue}, 70%, 55%, 0.9)`;
        // duas asas com escala oscilante (bater de asas)
        ctx.save();
        ctx.scale(1, 0.5 + Math.abs(flap) * 0.5);
        ctx.beginPath();
        ctx.ellipse(-f.size * 0.6, 0, f.size, f.size * 0.7, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(f.size * 0.6, 0, f.size, f.size * 0.7, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
        ctx.fillStyle = 'rgba(11, 31, 20, 0.7)';
        ctx.beginPath();
        ctx.ellipse(0, 0, f.size * 0.28, f.size * 0.5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    // ── Brotinho ao clicar (não ao mover) ──
    document.addEventListener('click', (e: MouseEvent) => {
      if (!isSolarTheme() || isReducedMotion()) return;
      const target = e.target as HTMLElement | null;
      if (target?.closest('a, button, input, textarea')) return; // evita poluir cliques de UI
      const layer = document.getElementById('solar-petal-layer');
      if (!layer) return;
      const sprout = document.createElement('div');
      sprout.className = 'solar-sprout';
      sprout.style.left = `${e.clientX}px`;
      sprout.style.top = `${e.clientY}px`;
      sprout.innerHTML =
        '<svg width="26" height="34" viewBox="0 0 26 34" xmlns="http://www.w3.org/2000/svg">' +
        '<path d="M13 33 C13 20 13 14 13 6" stroke="#4ade80" stroke-width="2" fill="none"/>' +
        '<path d="M13 18 C6 16 4 10 6 5 C12 6 14 12 13 18Z" fill="#4ade80"/>' +
        '<path d="M13 12 C19 10 22 5 20 1 C14 2 12 7 13 12Z" fill="#86efac"/>' +
        '</svg>';
      layer.appendChild(sprout);
      window.setTimeout(() => sprout.remove(), 2300);
    });

    // ── Pétalas caindo DURANTE a transição de página (evento, não loop contínuo) ──
    function spawnPetals() {
      if (!isSolarTheme() || isReducedMotion()) return;
      const layer = document.getElementById('solar-petal-layer');
      if (!layer) return;
      const count = 14;
      for (let i = 0; i < count; i++) {
        const petal = document.createElement('div');
        petal.className = 'solar-petal';
        const leftPct = Math.random() * 100;
        const duration = 1.8 + Math.random() * 1.4;
        const drift = (Math.random() - 0.5) * 160;
        const hue = Math.random() > 0.5 ? '#4ade80' : '#caa14b';
        petal.style.left = `${leftPct}vw`;
        petal.style.background = hue;
        petal.style.setProperty('--drift', `${drift}px`);
        petal.style.animationDuration = `${duration}s`;
        petal.style.animationDelay = `${Math.random() * 0.4}s`;
        layer.appendChild(petal);
        window.setTimeout(() => petal.remove(), (duration + 0.6) * 1000);
      }
    }
    document.addEventListener('astro:after-swap', spawnPetals);

    function frame() {
      requestAnimationFrame(frame);
      if (document.hidden || !isSolarTheme()) return;
      acquireCanvas();
      if (!canvas || !ctx) return;
      if (!fluttersInited) { initFlutters(canvas.width, canvas.height); fluttersInited = true; }

      const now = performance.now();
      const dt = 1 / 60;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      updateFlutters(now, dt);
      drawFlutters();
    }
    requestAnimationFrame(frame);
  })();
</script>
