---
// src/pages/index.astro
// M16: Sistema de Layouts Bespoke
// Renderiza o layout de Home bespoke de acordo com o tema ativo.
// O tema padrão do visitante novo é sempre matrix (decisão 10.10).
import Layout from '../layouts/Layout.astro';
import { getThemeHome } from '../themes';

interface Props {
  theme?: string;
}

const { theme = Astro.params.theme || 'matrix' } = Astro.props;
const ThemeHome = getThemeHome(theme);
---

<Layout title="Lonely Dev" theme={theme}>
  <ThemeHome theme={theme} />
</Layout>
