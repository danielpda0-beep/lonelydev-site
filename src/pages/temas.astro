---
// src/pages/temas.astro
// M17: Página /temas (A vitrine de webdesign)
// Decisões 10.6, 10.16 e 10.22
import Layout from '../layouts/Layout.astro';
import { getAllThemes } from '../themes';

interface Props {
  theme?: string;
}

const { theme = Astro.params.theme || 'matrix' } = Astro.props;
const allThemes = getAllThemes();
---

<Layout title="Temas & Vitrine de Webdesign | Lonely Dev" theme={theme}>
  <div class="temas-page">
    <!-- Cabeçalho da Vitrine -->
    <header class="temas-header">
      <p class="eyebrow">Engenharia de Interface & Webdesign</p>
      <h1 class="temas-title">Vitrine de Temas</h1>
      <p class="lead">
        O Lonely Dev não tem "um visual": tem um motor de interfaces sob medida.
        Cada tema reorganiza a estrutura visual, a cinematografia e a tipografia — consumindo exatamente o mesmo conteúdo.
        Navegue pelos estilos abaixo para ver o site se transformar ou encomende o seu projeto próprio.
      </p>
    </header>

    <!-- Catálogo de Cartões dos Temas -->
    <section class="temas-catalog-section" aria-labelledby="catalog-title">
      <h2 id="catalog-title" class="sr-only">Lista de temas disponíveis</h2>
      <div class="temas-grid">
        {allThemes.map((t) => {
          const CardComponent = t.Card;
          return <CardComponent isActive={theme === t.id} />;
        })}
      </div>
    </section>

    <!-- CTA Comercial de Webdesign (Requisito 5) -->
    <section class="webdesign-cta-section" aria-labelledby="webdesign-cta-title">
      <div class="cta-inner">
        <span class="cta-badge">Linha Web & Apps</span>
        <h2 id="webdesign-cta-title" class="cta-heading">
          Quer um site ou landing page com identidade própria?
        </h2>
        <p class="cta-desc">
          Estes estilos mostram a capacidade de engenharia de software e design de interação da Lonely Dev.
          Para o seu negócio, projeto ou produto, construo uma interface exclusiva sob medida com escopo fechado,
          preço único e código entregue — sem templates genéricos e sem mensalidades.
        </p>
        <div class="cta-actions">
          <a
            href="/contato?servico=Sites%20%26%20landing%20pages"
            class="btn btn-primary btn-lg"
          >
            Pedir orçamento de webdesign →
          </a>
          <a href="/servicos#landing-page-rapida" class="btn btn-ghost">
            Ver detalhes do serviço
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Lazy loading de iframes no desktop via IntersectionObserver
  function initThemeIframes() {
    // No celular (< 768px), o CSS oculta os iframes e exibe os screenshots estáticos
    if (window.innerWidth <= 768) return;

    const cards = document.querySelectorAll('[data-theme-preview]');
    if (!('IntersectionObserver' in window)) {
      // Fallback sem IntersectionObserver
      cards.forEach((card) => {
        const iframe = card.querySelector('iframe[data-src]') as HTMLIFrameElement | null;
        if (iframe && !iframe.getAttribute('src')) {
          iframe.setAttribute('src', iframe.getAttribute('data-src') || '');
        }
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const iframe = entry.target.querySelector('iframe[data-src]') as HTMLIFrameElement | null;
            if (iframe && !iframe.getAttribute('src')) {
              iframe.setAttribute('src', iframe.getAttribute('data-src') || '');
            }
            obs.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '120px' }
    );

    cards.forEach((card) => observer.observe(card));
  }

  initThemeIframes();
  document.addEventListener('astro:page-load', initThemeIframes);
</script>

<style>
  .temas-page {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl, 4rem);
    padding-bottom: var(--spacing-xl, 3rem);
  }

  /* Header */
  .temas-header {
    max-width: 820px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--spacing-xs, 0.5rem);
  }

  .temas-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--color-text);
    margin-bottom: var(--spacing-md, 1.5rem);
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Grid */
  .temas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg, 2rem);
  }

  @media (min-width: 768px) {
    .temas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* CTA de Webdesign */
  .webdesign-cta-section {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-xl, 3rem) var(--spacing-lg, 2rem);
    position: relative;
    overflow: hidden;
  }

  [data-theme="matrix"] .webdesign-cta-section {
    background-color: rgba(10, 20, 32, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: rgba(34, 211, 238, 0.4);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(34, 211, 238, 0.1);
  }

  .cta-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md, 1.5rem);
  }

  .cta-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: var(--color-bg-overlay);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0;
    line-height: 1.25;
  }

  .cta-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-sm, 1rem);
    margin-top: var(--spacing-xs, 0.5rem);
  }

  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    border: 1px solid var(--color-accent);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
  }

  .btn-ghost:hover {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 1.05rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
