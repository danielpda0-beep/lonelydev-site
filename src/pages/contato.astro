---
import Layout from '../layouts/Layout.astro';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || 'SUA_CHAVE_WEB3FORMS_AQUI';
const whatsappNumber = '5541997577116';
const whatsappFormatted = '(41) 99757-7116';
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const emailContato = 'lonelydevdev@gmail.com';
---

<Layout title="Contato | Lonely Dev">
  <div class="contato-page">
    <header class="page-header" aria-labelledby="page-title">
      <nav class="breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Contato</span>
      </nav>

      <p class="eyebrow">Contato & Briefing</p>
      <h1 id="page-title">Vamos conversar sobre o seu projeto</h1>
      <p class="lead">
        Projeto com começo, meio e fim: escopo fechado, preço único, data de entrega.
        Sem mensalidade, sem lock-in.
      </p>

      <div class="sla-banner" role="status">
        <span class="sla-icon" aria-hidden="true">⚡</span>
        <div class="sla-text">
          <strong>SLA de Atendimento:</strong> Respondo em até 1 dia útil.
        </div>
      </div>
    </header>

    <div class="contato-grid">
      <!-- COLUNA 1: CANAIS DIRETOS -->
      <section class="canais-section" aria-labelledby="canais-title">
        <h2 id="canais-title" class="section-title">Canais diretos</h2>
        <p class="section-desc">
          Prefere uma conversa direta? Escolha o canal de sua preferência:
        </p>

        <div class="canais-cards">
          <!-- WHATSAPP CARD -->
          <article class="canal-card canal-card--whatsapp">
            <div class="canal-icon" aria-hidden="true">💬</div>
            <div class="canal-content">
              <h3>WhatsApp Comercial</h3>
              <p class="canal-meta">{whatsappFormatted}</p>
              <p class="canal-desc">
                Ideal para mensagens rápidas, dúvidas pontuais ou envio de áudios e imagens.
              </p>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp"
              >
                Abrir conversa no WhatsApp →
              </a>
            </div>
          </article>

          <!-- EMAIL CARD -->
          <article class="canal-card canal-card--email">
            <div class="canal-icon" aria-hidden="true">✉️</div>
            <div class="canal-content">
              <h3>E-mail</h3>
              <p class="canal-meta">{emailContato}</p>
              <p class="canal-desc">
                Ideal para especificações técnicas mais longas, documentos ou arquivos anexos.
              </p>
              <a
                href={`mailto:${emailContato}`}
                class="btn btn-ghost"
              >
                Enviar e-mail direto →
              </a>
            </div>
          </article>
        </div>

        <!-- O QUE ESPERAR -->
        <div class="expectativa-box">
          <h3>Como funciona o retorno</h3>
          <ol class="expectativa-passos">
            <li>
              <strong>1. Avaliação técnica:</strong> Analiso seu problema e verifico se está dentro do escopo que atendo com excelência.
            </li>
            <li>
              <strong>2. Resposta em até 1 dia útil:</strong> Retorno com o que é possível fazer, o que não dá para fazer e eventuais dúvidas.
            </li>
            <li>
              <strong>3. Proposta fechada:</strong> Se houver viabilidade, envio escopo por escrito, preço fixo e data de entrega.
            </li>
          </ol>
        </div>
      </section>

      <!-- COLUNA 2: FORMULÁRIO DE BRIEFING -->
      <section class="form-section" aria-labelledby="form-title">
        <div class="form-card">
          <div class="form-header">
            <span class="badge badge-destaque">Briefing inicial</span>
            <h2 id="form-title">Envie os dados da sua demanda</h2>
            <p class="form-intro">
              Preencha o formulário abaixo para receber uma avaliação preliminar do seu projeto.
            </p>
          </div>

          <form
            id="briefing-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="briefing-form"
          >
            <!-- WEB3FORMS CONFIG -->
            <input type="hidden" name="access_key" id="access_key" value={web3formsAccessKey} />
            <input type="hidden" name="subject" value="Novo briefing recebido via site Lonely Dev" />
            <input type="hidden" name="from_name" value="Site Lonely Dev" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <!-- NOME -->
            <div class="form-group">
              <label for="nome" class="form-label">
                Seu nome ou empresa <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="nome"
                name="nome"
                required
                class="form-input"
                placeholder="Como devo te chamar?"
                autocomplete="name"
              />
            </div>

            <!-- CONTATO -->
            <div class="form-group">
              <label for="contato" class="form-label">
                Contato para retorno (e-mail ou telefone/WhatsApp) <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contato"
                name="contato"
                required
                class="form-input"
                placeholder="seuemail@exemplo.com ou (41) 99999-9999"
                autocomplete="email"
              />
            </div>

            <!-- MENSAGEM / NECESSIDADE -->
            <div class="form-group">
              <label for="mensagem" class="form-label">
                O que você precisa? <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="mensagem"
                name="mensagem"
                required
                rows="5"
                class="form-textarea"
                placeholder="Descreva o problema que você precisa resolver, o que deve ser construído, regras importantes ou ferramentas envolvidas..."
              ></textarea>
            </div>

            <!-- PRAZO DESEJADO -->
            <div class="form-group">
              <label for="prazo" class="form-label">
                Prazo desejado
              </label>
              <input
                type="text"
                id="prazo"
                name="prazo"
                class="form-input"
                placeholder="Ex: Urgente (< 15 dias), 20 a 30 dias, flexível..."
              />
            </div>

            <!-- ORÇAMENTO APROXIMADO -->
            <div class="form-group">
              <label for="orcamento" class="form-label">
                Orçamento aproximado (opcional)
              </label>
              <input
                type="text"
                id="orcamento"
                name="orcamento"
                class="form-input"
                placeholder="Ex: R$ 1.500, R$ 3.000 ou sob consulta"
              />
            </div>

            <!-- MENSAGENS DE FEEDBACK -->
            <div id="form-status" class="form-status" style="display: none;" role="alert"></div>

            <!-- SUBMIT BUTTON -->
            <button type="submit" id="submit-btn" class="btn btn-primary btn-submit">
              <span class="btn-text">Enviar briefing</span>
            </button>

            <p class="form-footer-note">
              🔒 Seus dados são usados exclusivamente para responder a esta solicitação. Sem spam, sem cadastro em listas.
            </p>
          </form>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  // Pré-preenchimento opcional a partir de query param ?servico=
  const urlParams = new URLSearchParams(window.location.search);
  const servicoParam = urlParams.get('servico');
  const textareaMensagem = document.getElementById('mensagem') as HTMLTextAreaElement | null;

  if (servicoParam && textareaMensagem && !textareaMensagem.value) {
    textareaMensagem.value = `Olá! Gostaria de um orçamento para o serviço: "${servicoParam}".\n\nDetalhes sobre o meu caso: `;
  }

  // Interceptação e envio AJAX do formulário Web3Forms
  const form = document.getElementById('briefing-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);

      // Atualiza UI para estado de carregamento
      submitBtn.disabled = true;
      const originalBtnHtml = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span class="btn-text">Enviando briefing...</span>';
      statusDiv.style.display = 'none';
      statusDiv.className = 'form-status';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          statusDiv.className = 'form-status form-status--success';
          statusDiv.innerHTML = '<strong>✓ Mensagem enviada com sucesso!</strong><br />Recebi seu briefing e responderei em até 1 dia útil no contato informado.';
          statusDiv.style.display = 'block';
          form.reset();
        } else {
          // Se a chave for placeholder ou inválida
          statusDiv.className = 'form-status form-status--error';
          statusDiv.innerHTML = `<strong>Aviso:</strong> ${data.message || 'Não foi possível enviar o formulário.'}<br /><br />Você pode enviar sua mensagem diretamente pelo <a href="https://wa.me/5541997577116" target="_blank" rel="noopener noreferrer">WhatsApp (+55 41 99757-7116)</a> ou pelo e-mail <a href="mailto:lonelydevdev@gmail.com">lonelydevdev@gmail.com</a>.`;
          statusDiv.style.display = 'block';
        }
      } catch (error) {
        statusDiv.className = 'form-status form-status--error';
        statusDiv.innerHTML = '<strong>Erro de conexão:</strong> Não foi possível completar o envio automático.<br /><br />Por favor, entre em contato direto pelo <a href="https://wa.me/5541997577116" target="_blank" rel="noopener noreferrer">WhatsApp (+55 41 99757-7116)</a> ou pelo e-mail <a href="mailto:lonelydevdev@gmail.com">lonelydevdev@gmail.com</a>.';
        statusDiv.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });
  }
</script>

<style>
  .contato-page {
    padding-bottom: var(--spacing-2xl);
    width: 100%;
  }

  .page-header {
    padding: var(--spacing-lg) 0 var(--spacing-xl);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-xl);
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb span[aria-current='page'] {
    color: var(--color-accent);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--spacing-xs);
  }

  .page-header h1 {
    font-size: clamp(1.5rem, 4.5vw, 2.5rem);
    margin-bottom: var(--spacing-sm);
    line-height: 1.25;
    word-break: break-word;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 65ch;
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
    word-break: break-word;
  }

  .sla-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(245, 166, 35, 0.1);
    border: 1px solid rgba(245, 166, 35, 0.35);
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--color-text);
    max-width: 100%;
    flex-wrap: wrap;
  }

  .sla-icon {
    color: var(--color-accent);
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .sla-text {
    line-height: 1.4;
  }

  .sla-text strong {
    color: var(--color-accent);
  }

  /* LAYOUT GRID */
  .contato-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    margin-top: var(--spacing-lg);
  }

  @media (min-width: 900px) {
    .contato-grid {
      grid-template-columns: 1fr 1.25fr;
      align-items: start;
    }
  }

  /* SEÇÃO DE CANAIS */
  .section-title {
    font-size: 1.4rem;
    margin-bottom: var(--spacing-xs);
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--spacing-lg);
  }

  .canais-cards {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .canal-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-lg);
    display: flex;
    gap: var(--spacing-md);
    transition: border-color 0.2s ease;
  }

  .canal-card:hover {
    border-color: rgba(245, 166, 35, 0.4);
  }

  .canal-card--whatsapp {
    border-left: 3px solid #25d366;
  }

  .canal-card--email {
    border-left: 3px solid var(--color-accent);
  }

  .canal-icon {
    font-size: 1.75rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .canal-content {
    flex: 1;
    min-width: 0;
  }

  .canal-content h3 {
    font-size: 1.15rem;
    margin-bottom: 0.2rem;
  }

  .canal-meta {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-accent);
    margin-bottom: var(--spacing-xs);
    word-break: break-word;
  }

  .canal-desc {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: var(--spacing-md);
  }

  /* EXPECTATIVA BOX */
  .expectativa-box {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-lg);
  }

  .expectativa-box h3 {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .expectativa-passos {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding: 0;
    margin: 0;
  }

  .expectativa-passos li {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .expectativa-passos strong {
    color: var(--color-text);
    font-weight: 600;
  }

  /* FORMULÁRIO */
  .form-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-lg);
    box-sizing: border-box;
    width: 100%;
  }

  .form-header {
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .badge-destaque {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(245, 166, 35, 0.15);
    color: var(--color-accent);
    border: 1px solid rgba(245, 166, 35, 0.3);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: var(--spacing-xs);
  }

  .form-header h2 {
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
    word-break: break-word;
  }

  .form-intro {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .briefing-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
    word-break: break-word;
  }

  .required {
    color: var(--color-accent);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    box-sizing: border-box;
    background-color: #1a1a1e;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.75rem 0.9rem;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.5;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(245, 166, 35, 0.2);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: #6a6a75;
  }

  /* BOTÕES */
  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.7rem 1.2rem;
    border-radius: 4px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
    cursor: pointer;
    box-sizing: border-box;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: #1a1a1e;
    border-color: var(--color-accent);
  }

  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #1a1a1e;
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-whatsapp {
    background-color: #25d366;
    color: #112a1a;
    border-color: #25d366;
    font-weight: 700;
  }

  .btn-whatsapp:hover {
    background-color: #2ee672;
    color: #0d2215;
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-submit {
    width: 100%;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
    margin-top: var(--spacing-xs);
  }

  .form-footer-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: var(--spacing-xs);
    margin-bottom: 0;
  }

  /* STATUS / FEEDBACK */
  .form-status {
    padding: var(--spacing-md);
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .form-status--success {
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.4);
    color: #72f09d;
  }

  .form-status--error {
    background: rgba(235, 87, 87, 0.12);
    border: 1px solid rgba(235, 87, 87, 0.4);
    color: #ff9e99;
  }

  .form-status a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .canal-card {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .form-card {
      padding: var(--spacing-md);
    }

    .btn {
      width: 100%;
    }
  }
</style>
