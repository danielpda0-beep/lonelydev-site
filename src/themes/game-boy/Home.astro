---
// src/themes/game-boy/Home.astro
// Layout Bespoke do Tema Game Boy (Tela de título de console portátil)
// Regra 10.9: Todo o conteúdo vem de homeContent e getPacotesFixos()
// Restrição de paleta (Decisão 10.7): só os 4 tokens de verde-oliva do tema, nunca cor solta.
import { homeContent, getPacotesFixos } from '../../data/homeContent';

interface Props {
  theme?: string;
}

const { theme = 'game-boy' } = Astro.props;
const pacotesFixos = await getPacotesFixos();
---

<div class="theme-gb-home" data-bespoke-layout="game-boy">
  <!-- Tela de título -->
  <section class="gb-title-screen" aria-labelledby="gb-hero-tagline">
    <p class="gb-eyebrow">■ {homeContent.hero.eyebrow} ■</p>
    <h1 id="gb-hero-tagline" class="gb-title">{homeContent.hero.tagline}</h1>
    <p class="gb-lead">{homeContent.hero.lead}</p>
    <a class="gb-btn gb-btn-primary" href={homeContent.hero.ctaHref}>▶ {homeContent.hero.ctaTexto}</a>
    <p class="gb-blink">PRESS START</p>
  </section>

  <!-- HUD de status -->
  <section class="gb-hud" aria-label="Status da partida">
    <span>{homeContent.telemetria.escopo}</span>
    <span>{homeContent.telemetria.preco}</span>
    <span>{homeContent.telemetria.prazo}</span>
    <span>{homeContent.telemetria.semMensalidade}</span>
    <span>{homeContent.telemetria.semLockin}</span>
  </section>

  <!-- Pilares como cartuchos -->
  <section class="gb-section" aria-labelledby="gb-pilares-title">
    <h2 id="gb-pilares-title" class="gb-section-title">▸ {homeContent.pilaresTitulo}</h2>
    <div class="gb-cartridges">
      {homeContent.pilares.map((pilar, idx) => (
        <a class:list={['gb-cartridge', { 'gb-cartridge-main': pilar.destaque }]} href={pilar.link}>
          <span class="gb-cart-slot">CART {idx + 1}</span>
          {pilar.badge && <span class="gb-badge">{pilar.badge}</span>}
          <h3 class="gb-cart-title">{pilar.titulo}</h3>
          <p class="gb-cart-desc">{pilar.resumo}</p>
          <span class="gb-cart-cta">{homeContent.pilaresCta} ▶</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Passos como save states -->
  <section class="gb-section" aria-labelledby="gb-passos-title">
    <h2 id="gb-passos-title" class="gb-section-title">▸ {homeContent.passosTitulo}</h2>
    <ol class="gb-saves">
      {homeContent.passos.map((passo) => (
        <li class="gb-save-slot">
          <span class="gb-save-n">SLOT {passo.n}</span>
          <span class="gb-save-title">{passo.titulo}</span>
          <span class="gb-save-desc">{passo.texto}</span>
        </li>
      ))}
    </ol>
    <a href={homeContent.passosLinkHref} class="gb-link">{homeContent.passosLinkTexto} ▶</a>
  </section>

  <!-- Pacotes fixos como shop de itens -->
  <section class="gb-section" aria-labelledby="gb-pacotes-title">
    <h2 id="gb-pacotes-title" class="gb-section-title">▸ {homeContent.pacotesInfo.titulo}</h2>
    <p class="gb-section-sub">{homeContent.pacotesInfo.intro}</p>
    <div class="gb-shop">
      {pacotesFixos.map((pacote) => (
        <article class="gb-item">
          <h3 class="gb-item-name">{pacote.data.nome}</h3>
          <p class="gb-item-desc">{pacote.data.resumo}</p>
          <div class="gb-item-price">{pacote.data.valor}</div>
          <div class="gb-item-time">{pacote.data.prazo_tipico}</div>
          <a class="gb-btn gb-btn-ghost" href="/contato">{pacote.data.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Portfolio como replay -->
  <section class="gb-section" aria-labelledby="gb-portfolio-title">
    <h2 id="gb-portfolio-title" class="gb-section-title">▸ {homeContent.portfolio.titulo}</h2>
    <div class="gb-replay-grid">
      {homeContent.portfolio.itens.map((item) => (
        <article class="gb-replay-card">
          <span class="gb-replay-status">{item.status === 'Disponível' ? '[OK]' : '[...]'}</span>
          <h3 class="gb-replay-title">{item.titulo}</h3>
          <p class="gb-replay-desc">{item.texto}</p>
        </article>
      ))}
    </div>
    <a href={homeContent.portfolio.ctaHref} class="gb-link">{homeContent.portfolio.ctaTexto} ▶</a>
  </section>

  <!-- Vitrine de temas -->
  <section class="gb-section" aria-labelledby="gb-temas-title">
    <h2 id="gb-temas-title" class="gb-section-title">▸ {homeContent.temasTeaser.titulo}</h2>
    <p class="gb-section-sub">{homeContent.temasTeaser.texto}</p>
    <a href={homeContent.temasTeaser.linkHref} class="gb-link">{homeContent.temasTeaser.linkTexto} ▶</a>
  </section>

  <!-- Continue? -->
  <section class="gb-continue" aria-labelledby="gb-cta-title">
    <p class="gb-continue-tag">CONTINUE?</p>
    <h2 id="gb-cta-title" class="gb-continue-title">{homeContent.ctaFinal.titulo}</h2>
    <p class="gb-continue-lead">{homeContent.ctaFinal.texto}</p>
    <a class="gb-btn gb-btn-primary gb-btn-lg" href={homeContent.ctaFinal.ctaHref}>▶ {homeContent.ctaFinal.ctaTexto}</a>
  </section>
</div>

<style>
  .theme-gb-home {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl, 4rem);
    position: relative;
    z-index: 2;
  }

  .gb-title-screen {
    text-align: center;
    padding: var(--spacing-xl, 3rem) var(--spacing-md, 1.5rem);
    background: var(--color-bg);
    border: 4px solid var(--color-accent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm, 1rem);
  }

  .gb-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--color-accent);
  }

  .gb-title {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 3.2vw, 1.6rem);
    line-height: 1.7;
    color: var(--color-text);
    max-width: 24ch;
  }

  .gb-lead {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 44ch;
  }

  .gb-blink {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    animation: gbBlink 1s steps(1) infinite;
  }

  @keyframes gbBlink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .gb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border: 3px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .gb-btn:hover {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .gb-btn-lg { font-size: 1rem; padding: 1rem 2rem; }

  .gb-btn-ghost {
    background: transparent;
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .gb-btn-ghost:hover { border-color: var(--color-accent); }

  .gb-hud {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-on-accent);
  }

  .gb-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, 1.5rem);
  }

  .gb-section-title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .gb-section-sub {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .gb-cartridges {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) {
    .gb-cartridges { grid-template-columns: repeat(3, 1fr); }
    .gb-cartridge-main { grid-column: 1 / -1; }
  }

  .gb-cartridge {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg);
    border: 3px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .gb-cartridge:hover {
    border-color: var(--color-accent);
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--color-accent);
  }

  .gb-cartridge-main { border-color: var(--color-accent); }

  .gb-cart-slot { font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted); }

  .gb-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    padding: 0.15rem 0.5rem;
  }

  .gb-cart-title { font-family: var(--font-mono); font-size: 1.05rem; color: var(--color-text); }
  .gb-cart-desc { font-family: var(--font-sans); font-size: 1.1rem; color: var(--color-text-muted); }
  .gb-cart-cta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); }

  .gb-saves {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .gb-save-slot {
    display: grid;
    grid-template-columns: 5rem 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    background: var(--color-bg-secondary);
    border-left: 3px solid var(--color-accent);
  }

  @media (max-width: 640px) {
    .gb-save-slot { grid-template-columns: 4rem 1fr; }
    .gb-save-desc { grid-column: 1 / -1; }
  }

  .gb-save-n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-on-accent); }
  .gb-save-title { font-family: var(--font-mono); font-size: 0.9rem; color: var(--color-text); }
  .gb-save-desc { font-family: var(--font-sans); font-size: 1.05rem; color: var(--color-text-muted); }

  .gb-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    align-self: flex-start;
  }

  .gb-link:hover { color: var(--color-accent-hover); }

  .gb-shop {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) { .gb-shop { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gb-shop { grid-template-columns: repeat(3, 1fr); } }

  .gb-item {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg);
    border: 2px dashed var(--color-border);
  }

  .gb-item-name { font-family: var(--font-mono); font-size: 1.05rem; color: var(--color-text); }
  .gb-item-desc { font-family: var(--font-sans); font-size: 1.1rem; color: var(--color-text-muted); flex: 1; }
  .gb-item-price { font-family: var(--font-mono); font-size: 1.25rem; color: var(--color-accent); }
  .gb-item-time { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted); }

  .gb-replay-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) { .gb-replay-grid { grid-template-columns: repeat(2, 1fr); } }

  .gb-replay-card {
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
  }

  .gb-replay-status { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-on-accent); }
  .gb-replay-title { font-family: var(--font-mono); font-size: 1.05rem; color: var(--color-text); margin: 0.4rem 0; }
  .gb-replay-desc { font-family: var(--font-sans); font-size: 1.1rem; color: var(--color-text-muted); }

  .gb-continue {
    text-align: center;
    padding: var(--spacing-xl, 3rem) var(--spacing-lg, 2rem);
    background: var(--color-bg);
    border: 4px solid var(--color-accent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .gb-continue-tag { font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-accent); letter-spacing: 0.2em; }
  .gb-continue-title { font-family: var(--font-mono); font-size: clamp(1rem, 3vw, 1.4rem); color: var(--color-text); }
  .gb-continue-lead { font-family: var(--font-sans); font-size: 1.3rem; color: var(--color-text-muted); max-width: 50ch; }
</style>
