---
// src/themes/game-boy/ThemeCard.astro
import meta from './theme.json';

interface Props {
  isActive?: boolean;
}

const { isActive = false } = Astro.props;
---

<article class:list={['theme-card', 'theme-card-gb', { 'is-active': isActive }]}>
  <div class="theme-preview-container">
    <div class="theme-iframe-wrap">
      <iframe data-src="/t/game-boy" title="Miniatura ao vivo do tema Game Boy" class="theme-live-iframe" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
    </div>
    <div class="theme-static-wrap">
      <img src="/images/themes/game-boy.png" alt="Screenshot do tema Game Boy" class="theme-static-img" loading="lazy" />
    </div>
    <div class="preview-overlay-badge">
      <span class="swatch-dot"></span>
      <span>{meta.name}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-title-group">
        <h3 class="card-title">{meta.name}</h3>
        <span class="card-tagline">{meta.tagline}</span>
      </div>
      {isActive && <span class="badge-active">Tema Ativo</span>}
    </div>
    <p class="card-desc">{meta.description}</p>
    <div class="card-footer">
      <a href="/t/game-boy" class="btn-theme-select">
        {isActive ? 'Ver páginas neste tema ▶' : 'Ver o site inteiro assim ▶'}
      </a>
    </div>
  </div>
</article>

<style>
  .theme-card-gb {
    background: #e4efc9;
    border: 3px solid #12200d;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .theme-card-gb:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 #2f4f22;
  }

  .theme-card-gb.is-active {
    box-shadow: 0 0 0 2px #2f4f22;
  }

  .theme-preview-container {
    width: 100%;
    height: 220px;
    position: relative;
    background-color: #e4efc9;
    overflow: hidden;
    border-bottom: 3px solid #12200d;
  }

  .theme-iframe-wrap { width: 100%; height: 100%; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .theme-live-iframe { width: 1200px; height: 800px; border: none; transform-origin: 0 0; transform: scale(0.35); pointer-events: none; }
  .theme-static-wrap { display: none; width: 100%; height: 100%; }
  .theme-static-img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  @media (max-width: 768px) {
    .theme-iframe-wrap { display: none !important; }
    .theme-static-wrap { display: block !important; }
  }

  .preview-overlay-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: #e4efc9;
    border: 2px solid #12200d;
    padding: 0.25rem 0.6rem;
    font-family: 'Silkscreen', monospace;
    font-size: 0.6rem;
    color: #12200d;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .swatch-dot { width: 8px; height: 8px; background: #2f4f22; border: 1px solid #12200d; }

  .card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; flex: 1; }
  .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
  .card-title { font-family: 'Silkscreen', monospace; font-size: 0.95rem; color: #12200d; margin: 0; }
  .card-tagline { font-family: 'VT323', monospace; font-size: 0.9rem; color: #2f4f22; display: block; margin-top: 0.4rem; }

  .badge-active {
    background: #12200d;
    border: 1px solid #12200d;
    color: #e4efc9;
    font-family: 'VT323', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
  }

  .card-desc { color: #2f4f22; font-size: 0.95rem; line-height: 1.55; margin: 0; flex: 1; font-family: 'VT323', monospace; }
  .card-footer { margin-top: auto; padding-top: 0.5rem; }

  .btn-theme-select {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: #12200d;
    border: 2px solid #12200d;
    color: #e4efc9;
    font-family: 'VT323', monospace;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.6rem 1rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-theme-select:hover {
    background-color: #2f4f22;
    border-color: #2f4f22;
  }
</style>
