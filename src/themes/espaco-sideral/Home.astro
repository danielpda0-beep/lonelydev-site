---
// src/themes/espaco-sideral/Home.astro
// Layout Bespoke do Tema Espaço Sideral (Estações Distantes)
// Regra 10.9: Todo o conteúdo vem de homeContent e getPacotesFixos()
import { homeContent, getPacotesFixos } from '../../data/homeContent';

interface Props {
  theme?: string;
}

const { theme = 'espaco-sideral' } = Astro.props;
const pacotesFixos = await getPacotesFixos();
---

<div class="theme-espaco-home" data-bespoke-layout="espaco-sideral">
  <!-- Estação Base -->
  <section class="esp-station" aria-labelledby="esp-hero-tagline">
    <p class="esp-coords">ESTAÇÃO BASE · {homeContent.hero.eyebrow}</p>
    <h1 id="esp-hero-tagline" class="esp-title">{homeContent.hero.tagline}</h1>
    <p class="esp-lead">{homeContent.hero.lead}</p>
    <a class="esp-btn" href={homeContent.hero.ctaHref}>{homeContent.hero.ctaTexto}</a>
  </section>

  <!-- Log de telemetria -->
  <section class="esp-telemetry" aria-label="Telemetria do modelo de trabalho">
    <ul class="esp-telemetry-list">
      <li>{homeContent.telemetria.escopo}</li>
      <li>{homeContent.telemetria.preco}</li>
      <li>{homeContent.telemetria.prazo}</li>
      <li>{homeContent.telemetria.semMensalidade}</li>
      <li>{homeContent.telemetria.semLockin}</li>
    </ul>
  </section>

  <!-- Estações orbitais (pilares) -->
  <section class="esp-sector" aria-labelledby="esp-pilares-title">
    <p class="esp-sector-tag">SETOR 01</p>
    <h2 id="esp-pilares-title" class="esp-sector-title">{homeContent.pilaresTitulo}</h2>
    <div class="esp-stations-grid">
      {homeContent.pilares.map((pilar, idx) => (
        <a class:list={['esp-station-card', { 'esp-station-command': pilar.destaque }]} href={pilar.link}>
          <span class="esp-station-id">ESTAÇÃO {String(idx + 1).padStart(2, '0')}</span>
          {pilar.badge && <span class="esp-badge">{pilar.badge}</span>}
          <h3 class="esp-station-name">{pilar.titulo}</h3>
          <p class="esp-station-desc">{pilar.resumo}</p>
          <span class="esp-station-link">{homeContent.pilaresCta} →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Diário de bordo (como funciona) -->
  <section class="esp-sector" aria-labelledby="esp-passos-title">
    <p class="esp-sector-tag">SETOR 02</p>
    <h2 id="esp-passos-title" class="esp-sector-title">{homeContent.passosTitulo}</h2>
    <div class="esp-log">
      {homeContent.passos.map((passo) => (
        <div class="esp-log-entry">
          <span class="esp-log-num">LOG_{passo.n}</span>
          <h3 class="esp-log-title">{passo.titulo}</h3>
          <p class="esp-log-text">{passo.texto}</p>
        </div>
      ))}
    </div>
    <a href={homeContent.passosLinkHref} class="esp-link">{homeContent.passosLinkTexto} →</a>
  </section>

  <!-- Manifesto de carga (pacotes fixos) -->
  <section class="esp-sector" aria-labelledby="esp-pacotes-title">
    <p class="esp-sector-tag">SETOR 03</p>
    <h2 id="esp-pacotes-title" class="esp-sector-title">{homeContent.pacotesInfo.titulo}</h2>
    <p class="esp-sector-sub">{homeContent.pacotesInfo.intro}</p>
    <div class="esp-cargo-grid">
      {pacotesFixos.map((pacote, idx) => (
        <article class="esp-cargo">
          <span class="esp-cargo-id">CARGA_0{idx + 1}</span>
          <h3 class="esp-cargo-name">{pacote.data.nome}</h3>
          <p class="esp-cargo-desc">{pacote.data.resumo}</p>
          <p class="esp-cargo-price">{pacote.data.valor} · {pacote.data.prazo_tipico}</p>
          <a class="esp-btn esp-btn-ghost" href="/contato">{pacote.data.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Arquivo estelar (portfólio) -->
  <section class="esp-sector" aria-labelledby="esp-portfolio-title">
    <p class="esp-sector-tag">SETOR 04</p>
    <h2 id="esp-portfolio-title" class="esp-sector-title">{homeContent.portfolio.titulo}</h2>
    <div class="esp-archive-grid">
      {homeContent.portfolio.itens.map((item) => (
        <article class="esp-archive">
          <span class="esp-archive-status">{item.status}</span>
          <h3 class="esp-archive-title">{item.titulo}</h3>
          <p class="esp-archive-text">{item.texto}</p>
        </article>
      ))}
    </div>
    <a href={homeContent.portfolio.ctaHref} class="esp-link">{homeContent.portfolio.ctaTexto} →</a>
  </section>

  <!-- Vitrine de temas -->
  <section class="esp-sector" aria-labelledby="esp-temas-title">
    <p class="esp-sector-tag">SETOR 05</p>
    <h2 id="esp-temas-title" class="esp-sector-title">{homeContent.temasTeaser.titulo}</h2>
    <p class="esp-sector-sub">{homeContent.temasTeaser.texto}</p>
    <a href={homeContent.temasTeaser.linkHref} class="esp-link">{homeContent.temasTeaser.linkTexto} →</a>
  </section>

  <!-- Transmissão final -->
  <section class="esp-transmission" aria-labelledby="esp-cta-title">
    <p class="esp-transmission-tag">TRANSMISSÃO ABERTA</p>
    <h2 id="esp-cta-title" class="esp-transmission-title">{homeContent.ctaFinal.titulo}</h2>
    <p class="esp-transmission-text">{homeContent.ctaFinal.texto}</p>
    <a class="esp-btn esp-btn-lg" href={homeContent.ctaFinal.ctaHref}>{homeContent.ctaFinal.ctaTexto}</a>
  </section>
</div>

<style>
  .theme-espaco-home {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl, 4rem);
    position: relative;
    z-index: 2;
  }

  .esp-station {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm, 1rem);
    max-width: 64ch;
  }

  .esp-coords {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--color-accent);
  }

  .esp-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    color: var(--color-text);
    text-shadow: 0 0 30px rgba(192, 132, 252, 0.3);
  }

  .esp-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .esp-btn {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-weight: 600;
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0 25px rgba(192, 132, 252, 0.4);
    transition: all 0.2s ease;
  }

  .esp-btn:hover {
    background: var(--color-accent-hover);
    box-shadow: 0 0 35px rgba(192, 132, 252, 0.6);
  }

  .esp-btn-ghost {
    background: transparent;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    box-shadow: none;
  }

  .esp-btn-ghost:hover {
    background: rgba(192, 132, 252, 0.15);
    color: var(--color-accent);
  }

  .esp-btn-lg {
    font-size: 1.05rem;
    padding: 1rem 2.25rem;
  }

  .esp-telemetry {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem 1.5rem;
  }

  .esp-telemetry-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .esp-telemetry-list li::before {
    content: "✦ ";
    color: var(--color-accent);
  }

  .esp-sector {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, 1.5rem);
  }

  .esp-sector-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .esp-sector-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--color-text);
  }

  .esp-sector-sub {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .esp-stations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) {
    .esp-stations-grid { grid-template-columns: repeat(3, 1fr); }
    .esp-station-command { grid-column: 1 / -1; }
  }

  .esp-station-card {
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .esp-station-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 0 25px rgba(192, 132, 252, 0.2);
  }

  .esp-station-id {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .esp-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .esp-station-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-text);
  }

  .esp-station-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    flex: 1;
  }

  .esp-station-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .esp-log {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) {
    .esp-log { grid-template-columns: repeat(3, 1fr); }
  }

  .esp-log-entry {
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg-secondary);
    border-left: 2px solid var(--color-accent);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .esp-log-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .esp-log-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .esp-log-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .esp-link {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .esp-link:hover {
    color: var(--color-accent-hover);
  }

  .esp-cargo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) {
    .esp-cargo-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .esp-cargo-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .esp-cargo {
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .esp-cargo-id {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .esp-cargo-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .esp-cargo-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    flex: 1;
  }

  .esp-cargo-price {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-accent);
  }

  .esp-archive-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.5rem);
  }

  @media (min-width: 768px) {
    .esp-archive-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .esp-archive {
    padding: var(--spacing-lg, 2rem);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .esp-archive-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .esp-archive-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .esp-archive-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .esp-transmission {
    text-align: center;
    padding: var(--spacing-xl, 3rem) var(--spacing-lg, 2rem);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-accent);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .esp-transmission-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    color: var(--color-accent);
  }

  .esp-transmission-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    color: var(--color-text);
  }

  .esp-transmission-text {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 50ch;
  }
</style>
