---
// src/themes/vintage/ThemeCard.astro
import meta from './theme.json';

interface Props {
  isActive?: boolean;
}

const { isActive = false } = Astro.props;
---

<article class:list={['theme-card', 'theme-card-vintage', { 'is-active': isActive }]}>
  <div class="theme-preview-container">
    <div class="theme-iframe-wrap">
      <iframe data-src="/t/vintage" title="Miniatura ao vivo do tema Vintage" class="theme-live-iframe" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
    </div>
    <div class="theme-static-wrap">
      <img src="/images/themes/vintage.png" alt="Screenshot do tema Vintage" class="theme-static-img" loading="lazy" />
    </div>
    <div class="preview-overlay-badge">
      <span class="swatch-dot" style="background: #7a2e1d;"></span>
      <span>{meta.name}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-title-group">
        <h3 class="card-title">{meta.name}</h3>
        <span class="card-tagline">{meta.tagline}</span>
      </div>
      {isActive && <span class="badge-active">Tema Ativo</span>}
    </div>
    <p class="card-desc">{meta.description}</p>
    <div class="card-footer">
      <a href="/t/vintage" class="btn-theme-select">
        {isActive ? 'Ver páginas neste tema →' : 'Ver o site inteiro assim →'}
      </a>
    </div>
  </div>
</article>

<style>
  .theme-card-vintage {
    background: #e8d9bd;
    border: 1px solid #c9b48a;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 6px 20px rgba(58, 42, 26, 0.2);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theme-card-vintage:hover {
    border-color: #7a2e1d;
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(58, 42, 26, 0.3);
  }

  .theme-card-vintage.is-active {
    border-color: #7a2e1d;
    box-shadow: 0 0 0 2px rgba(122, 46, 29, 0.4);
  }

  .theme-preview-container {
    width: 100%;
    height: 220px;
    position: relative;
    background-color: #f2e8d5;
    overflow: hidden;
    border-bottom: 1px solid #c9b48a;
  }

  .theme-iframe-wrap { width: 100%; height: 100%; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .theme-live-iframe { width: 1200px; height: 800px; border: none; transform-origin: 0 0; transform: scale(0.35); pointer-events: none; }
  .theme-static-wrap { display: none; width: 100%; height: 100%; }
  .theme-static-img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  @media (max-width: 768px) {
    .theme-iframe-wrap { display: none !important; }
    .theme-static-wrap { display: block !important; }
  }

  .preview-overlay-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(242, 232, 213, 0.92);
    border: 1px solid rgba(122, 46, 29, 0.4);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-family: 'Special Elite', monospace;
    font-size: 0.72rem;
    color: #3a2a1a;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .swatch-dot { width: 8px; height: 8px; border-radius: 50%; }

  .card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; flex: 1; }
  .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
  .card-title { font-family: 'Special Elite', monospace; font-size: 1.3rem; color: #3a2a1a; margin: 0; }
  .card-tagline { font-family: 'Special Elite', monospace; font-size: 0.8rem; color: #7a2e1d; display: block; margin-top: 0.35rem; }

  .badge-active {
    background: rgba(122, 46, 29, 0.15);
    border: 1px solid #7a2e1d;
    color: #7a2e1d;
    font-family: 'Special Elite', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-desc { color: #6b5640; font-size: 0.95rem; line-height: 1.55; margin: 0; flex: 1; }
  .card-footer { margin-top: auto; padding-top: 0.5rem; }

  .btn-theme-select {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: transparent;
    border: 2px solid #7a2e1d;
    color: #7a2e1d;
    font-family: 'Special Elite', monospace;
    font-size: 0.9rem;
    padding: 0.65rem 1rem;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-theme-select:hover {
    background-color: #7a2e1d;
    color: #f2e8d5;
  }
</style>
