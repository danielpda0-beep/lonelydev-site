---
// src/themes/business/ThemeCard.astro
// Cartão do tema Business para a vitrine /temas (M17)
import meta from './theme.json';

interface Props {
  isActive?: boolean;
}

const { isActive = false } = Astro.props;
---

<article class:list={['theme-card', 'theme-card-business', { 'is-active': isActive }]}>
  <!-- Área de Miniatura: Live iframe no desktop + screenshot estático no celular -->
  <div class="theme-preview-container" data-theme-preview="business">
    <!-- Desktop: Iframe vivo com scale -->
    <div class="theme-iframe-wrap">
      <iframe
        data-src="/t/business"
        title="Miniatura ao vivo do tema Business"
        class="theme-live-iframe"
        loading="lazy"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    </div>
    <!-- Mobile: Screenshot estático (zero sobrecarga de CPU/bateria) -->
    <div class="theme-static-wrap">
      <img
        src="/images/themes/business.png"
        alt="Screenshot do tema Business"
        class="theme-static-img"
        loading="lazy"
      />
    </div>
    <div class="preview-overlay-badge">
      <span class="swatch-dot" style="background: #f5a623;"></span>
      <span>{meta.name}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-title-group">
        <h3 class="card-title">{meta.name}</h3>
        <span class="card-tagline">{meta.tagline}</span>
      </div>
      {isActive && <span class="badge-active">Tema Ativo</span>}
    </div>

    <p class="card-desc">{meta.description}</p>

    <div class="card-footer">
      <a href="/t/business" class="btn-theme-select">
        {isActive ? 'Ver páginas neste tema →' : 'Ver o site inteiro assim →'}
      </a>
    </div>
  </div>
</article>

<style>
  .theme-card-business {
    background-color: #25252a;
    border: 1px solid #3a3a40;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theme-card-business:hover {
    border-color: #f5a623;
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .theme-card-business.is-active {
    border-color: #f5a623;
    box-shadow: 0 0 0 2px rgba(245, 166, 35, 0.4);
  }

  .theme-preview-container {
    width: 100%;
    height: 220px;
    position: relative;
    background-color: #1a1a1e;
    overflow: hidden;
    border-bottom: 1px solid #3a3a40;
  }

  /* Desktop live iframe wrapper */
  .theme-iframe-wrap {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none; /* Previne captura de clique do iframe */
  }

  .theme-live-iframe {
    width: 1200px;
    height: 800px;
    border: none;
    transform-origin: 0 0;
    transform: scale(0.35);
    pointer-events: none;
  }

  /* Mobile static fallback */
  .theme-static-wrap {
    display: none;
    width: 100%;
    height: 100%;
  }

  .theme-static-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  @media (max-width: 768px) {
    .theme-iframe-wrap {
      display: none !important;
    }
    .theme-static-wrap {
      display: block !important;
    }
  }

  .preview-overlay-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(26, 26, 30, 0.88);
    border: 1px solid #3a3a40;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: #e8e8e8;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .swatch-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .card-title {
    font-family: var(--font-mono, monospace);
    font-size: 1.35rem;
    color: #e8e8e8;
    margin: 0;
  }

  .card-tagline {
    font-family: var(--font-mono, monospace);
    font-size: 0.825rem;
    color: #f5a623;
    display: block;
    margin-top: 0.25rem;
  }

  .badge-active {
    background: #f5a623;
    color: #1a1a1e;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-desc {
    color: #a0a0a0;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .btn-theme-select {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: transparent;
    border: 1px solid #f5a623;
    color: #f5a623;
    font-family: var(--font-mono, monospace);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.65rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-theme-select:hover {
    background-color: #f5a623;
    color: #1a1a1e;
  }
</style>
