---
// src/themes/matrix/ThemeCard.astro
// Cartão do tema Matrix para a vitrine /temas (M17)
import meta from './theme.json';

interface Props {
  isActive?: boolean;
}

const { isActive = false } = Astro.props;
---

<article class:list={['theme-card', 'theme-card-matrix', { 'is-active': isActive }]}>
  <!-- Área de Miniatura: Live iframe no desktop + screenshot estático no celular -->
  <div class="theme-preview-container" data-theme-preview="matrix">
    <!-- Desktop: Iframe vivo com scale -->
    <div class="theme-iframe-wrap">
      <iframe
        data-src="/t/matrix"
        title="Miniatura ao vivo do tema Matrix"
        class="theme-live-iframe"
        loading="lazy"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
    </div>
    <!-- Mobile: Screenshot estático (zero sobrecarga de CPU/bateria) -->
    <div class="theme-static-wrap">
      <img
        src="/images/themes/matrix.png"
        alt="Screenshot do tema Matrix"
        class="theme-static-img"
        loading="lazy"
      />
    </div>
    <div class="preview-overlay-badge">
      <span class="swatch-dot" style="background: #22d3ee; box-shadow: 0 0 6px #22d3ee;"></span>
      <span>{meta.name}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-title-group">
        <h3 class="card-title">{meta.name}</h3>
        <span class="card-tagline">{meta.tagline}</span>
      </div>
      {isActive && <span class="badge-active">Tema Ativo</span>}
    </div>

    <p class="card-desc">{meta.description}</p>

    <div class="card-footer">
      <a href="/t/matrix" class="btn-theme-select">
        {isActive ? 'Ver páginas neste tema →' : 'Ver o site inteiro assim →'}
      </a>
    </div>
  </div>
</article>

<style>
  .theme-card-matrix {
    background: rgba(10, 20, 32, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 15px rgba(34, 211, 238, 0.08);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theme-card-matrix:hover {
    border-color: #22d3ee;
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(34, 211, 238, 0.2);
  }

  .theme-card-matrix.is-active {
    border-color: #22d3ee;
    box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.45), 0 0 20px rgba(34, 211, 238, 0.2);
  }

  .theme-preview-container {
    width: 100%;
    height: 220px;
    position: relative;
    background-color: #05070a;
    overflow: hidden;
    border-bottom: 1px solid rgba(34, 211, 238, 0.25);
  }

  /* Desktop live iframe wrapper */
  .theme-iframe-wrap {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .theme-live-iframe {
    width: 1200px;
    height: 800px;
    border: none;
    transform-origin: 0 0;
    transform: scale(0.35);
    pointer-events: none;
  }

  /* Mobile static fallback */
  .theme-static-wrap {
    display: none;
    width: 100%;
    height: 100%;
  }

  .theme-static-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  @media (max-width: 768px) {
    .theme-iframe-wrap {
      display: none !important;
    }
    .theme-static-wrap {
      display: block !important;
    }
  }

  .preview-overlay-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(10, 20, 32, 0.9);
    border: 1px solid rgba(34, 211, 238, 0.4);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: #e0f4ff;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .swatch-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .card-title {
    font-family: var(--font-mono, monospace);
    font-size: 1.35rem;
    color: #e0f4ff;
    margin: 0;
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.3);
  }

  .card-tagline {
    font-family: var(--font-mono, monospace);
    font-size: 0.825rem;
    color: #22d3ee;
    display: block;
    margin-top: 0.25rem;
  }

  .badge-active {
    background: rgba(34, 211, 238, 0.2);
    border: 1px solid #22d3ee;
    color: #22d3ee;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    box-shadow: 0 0 8px rgba(34, 211, 238, 0.3);
  }

  .card-desc {
    color: #7ab8d4;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .btn-theme-select {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid #22d3ee;
    color: #22d3ee;
    font-family: var(--font-mono, monospace);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.65rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 0 10px rgba(34, 211, 238, 0.15);
  }

  .btn-theme-select:hover {
    background-color: #22d3ee;
    color: #0a1420;
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.4);
  }
</style>
