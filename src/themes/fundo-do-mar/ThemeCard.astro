---
// src/themes/fundo-do-mar/ThemeCard.astro
import meta from './theme.json';

interface Props {
  isActive?: boolean;
}

const { isActive = false } = Astro.props;
---

<article class:list={['theme-card', 'theme-card-mar', { 'is-active': isActive }]}>
  <div class="theme-preview-container">
    <div class="theme-iframe-wrap">
      <iframe data-src="/t/fundo-do-mar" title="Miniatura ao vivo do tema Fundo do Mar" class="theme-live-iframe" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
    </div>
    <div class="theme-static-wrap">
      <img src="/images/themes/fundo-do-mar.png" alt="Screenshot do tema Fundo do Mar" class="theme-static-img" loading="lazy" />
    </div>
    <div class="preview-overlay-badge">
      <span class="swatch-dot" style="background: #2dd4bf; box-shadow: 0 0 6px #2dd4bf;"></span>
      <span>{meta.name}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-title-group">
        <h3 class="card-title">{meta.name}</h3>
        <span class="card-tagline">{meta.tagline}</span>
      </div>
      {isActive && <span class="badge-active">Tema Ativo</span>}
    </div>
    <p class="card-desc">{meta.description}</p>
    <div class="card-footer">
      <a href="/t/fundo-do-mar" class="btn-theme-select">
        {isActive ? 'Ver páginas neste tema →' : 'Ver o site inteiro assim →'}
      </a>
    </div>
  </div>
</article>

<style>
  .theme-card-mar {
    background: #06283a;
    border: 1px solid #0f3d52;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theme-card-mar:hover {
    border-color: #2dd4bf;
    transform: translateY(-3px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5), 0 0 20px rgba(45, 212, 191, 0.15);
  }

  .theme-card-mar.is-active {
    border-color: #2dd4bf;
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.4);
  }

  .theme-preview-container {
    width: 100%;
    height: 220px;
    position: relative;
    background-color: #041c2c;
    overflow: hidden;
    border-bottom: 1px solid #0f3d52;
  }

  .theme-iframe-wrap { width: 100%; height: 100%; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .theme-live-iframe { width: 1200px; height: 800px; border: none; transform-origin: 0 0; transform: scale(0.35); pointer-events: none; }
  .theme-static-wrap { display: none; width: 100%; height: 100%; }
  .theme-static-img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  @media (max-width: 768px) {
    .theme-iframe-wrap { display: none !important; }
    .theme-static-wrap { display: block !important; }
  }

  .preview-overlay-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(4, 28, 44, 0.9);
    border: 1px solid rgba(45, 212, 191, 0.4);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    color: #d9f5f5;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .swatch-dot { width: 8px; height: 8px; border-radius: 50%; }

  .card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; flex: 1; }
  .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
  .card-title { font-family: 'Comfortaa', sans-serif; font-size: 1.3rem; color: #d9f5f5; margin: 0; }
  .card-tagline { font-family: 'Inter', sans-serif; font-size: 0.85rem; color: #2dd4bf; display: block; margin-top: 0.3rem; }

  .badge-active {
    background: rgba(45, 212, 191, 0.15);
    border: 1px solid #2dd4bf;
    color: #2dd4bf;
    font-size: 0.7rem;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .card-desc { color: #8fc3cd; font-size: 0.95rem; line-height: 1.55; margin: 0; flex: 1; }
  .card-footer { margin-top: auto; padding-top: 0.5rem; }

  .btn-theme-select {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: rgba(45, 212, 191, 0.12);
    border: 1px solid #2dd4bf;
    color: #2dd4bf;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-theme-select:hover {
    background-color: #2dd4bf;
    color: #041c2c;
  }
</style>
