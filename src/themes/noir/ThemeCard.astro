---
// src/themes/noir/ThemeCard.astro
import meta from './theme.json';

interface Props {
  isActive?: boolean;
}

const { isActive = false } = Astro.props;
---

<article class:list={['theme-card', 'theme-card-nr', { 'is-active': isActive }]}>
  <div class="theme-preview-container">
    <div class="theme-iframe-wrap">
      <iframe data-src="/t/noir" title="Miniatura ao vivo do tema Noir" class="theme-live-iframe" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
    </div>
    <div class="theme-static-wrap">
      <img src="/images/themes/noir.png" alt="Screenshot do tema Noir" class="theme-static-img" loading="lazy" />
    </div>
    <div class="preview-overlay-badge">
      <span class="swatch-dot" style="background: #d4d4d4; box-shadow: 0 0 6px #d4d4d4;"></span>
      <span>{meta.name}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-title-group">
        <h3 class="card-title">{meta.name}</h3>
        <span class="card-tagline">{meta.tagline}</span>
      </div>
      {isActive && <span class="badge-active">Tema Ativo</span>}
    </div>
    <p class="card-desc">{meta.description}</p>
    <div class="card-footer">
      <a href="/t/noir" class="btn-theme-select">
        {isActive ? 'Ver páginas neste tema →' : 'Ver o site inteiro assim →'}
      </a>
    </div>
  </div>
</article>

<style>
  .theme-card-nr {
    background: #0a0a0a;
    border: 1px solid #333333;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.6);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theme-card-nr:hover {
    border-color: #d4d4d4;
    transform: translateY(-3px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.7);
  }

  .theme-card-nr.is-active {
    border-color: #ffffff;
    box-shadow: 0 0 0 2px rgba(212, 212, 212, 0.4);
  }

  .theme-preview-container {
    width: 100%;
    height: 220px;
    position: relative;
    background-color: #0a0a0a;
    overflow: hidden;
    border-bottom: 1px solid #333333;
  }

  .theme-iframe-wrap { width: 100%; height: 100%; position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .theme-live-iframe { width: 1200px; height: 800px; border: none; transform-origin: 0 0; transform: scale(0.35); pointer-events: none; }
  .theme-static-wrap { display: none; width: 100%; height: 100%; }
  .theme-static-img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  @media (max-width: 768px) {
    .theme-iframe-wrap { display: none !important; }
    .theme-static-wrap { display: block !important; }
  }

  .preview-overlay-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(10, 10, 10, 0.9);
    border: 1px solid rgba(212, 212, 212, 0.4);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    color: #f2f2f2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .swatch-dot { width: 8px; height: 8px; border-radius: 50%; }

  .card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; flex: 1; }
  .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
  .card-title { font-family: 'Cinzel', serif; font-size: 1.1rem; color: #f2f2f2; margin: 0; text-transform: uppercase; }
  .card-tagline { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: #9a9a9a; display: block; margin-top: 0.35rem; }

  .badge-active {
    background: rgba(212, 212, 212, 0.12);
    border: 1px solid #d4d4d4;
    color: #d4d4d4;
    font-size: 0.65rem;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-desc { color: #9a9a9a; font-size: 0.95rem; line-height: 1.55; margin: 0; flex: 1; }
  .card-footer { margin-top: auto; padding-top: 0.5rem; }

  .btn-theme-select {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: rgba(212, 212, 212, 0.08);
    border: 1px solid #d4d4d4;
    color: #d4d4d4;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-theme-select:hover {
    background-color: #d4d4d4;
    color: #0a0a0a;
  }
</style>
